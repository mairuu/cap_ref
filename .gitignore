# Prior-art baggage — the source matters, the installed trees do not
**/node_modules/
**/.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Build outputs (if this workspace ever sits next to cap_ws)
build/
install/
log/

# Bags and maps are big and regenerable — keep them out of the docs repo
*.db3
*.mcap
*.pgm

# arduino-cli, fetched by hand to build the ESP32 firmware. 34 MB static
# binary, not source, and not this repo's subject.
bin/

# Editor
.DS_Store
*.swp
